{
  "id": "demo-09",
  "name": "Демо-бот: /classify — классификатор заявок (LLM)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "demo/classify",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "wh-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "demo-classify"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst text = String(body.text || '').slice(0, 2000);\nif (!text.trim()) { throw new Error('text is required'); }\nreturn [{ json: { text, user: String(body.user || 'аноним') } }];"
      },
      "id": "code-1",
      "name": "Валидация",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://opencode.ai/zen/go/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-opencode-session",
              "value": "n8n-demo-stand"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'deepseek-flash', temperature: 0.1, messages: [ { role: 'system', content: 'Ты — маршрутизатор заявок в IT-студии. Ответь СТРОГО одним JSON: {\"category\": одно из [\"разработка\",\"интеграция\",\"бот\",\"данные\",\"прочее\"], \"priority\": одно из [\"низкий\",\"средний\",\"высокий\"], \"summary\": \"краткое резюме до 100 символов\"}. Никакого текста кроме JSON.' }, { role: 'user', content: $json.text } ] }) }}",
        "options": {}
      },
      "id": "http-1",
      "name": "LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "deepseek-api",
          "name": "deepseek-api"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nlet parsed;\ntry { parsed = JSON.parse(r.choices[0].message.content); } catch (e) { parsed = { category: 'прочее', priority: 'средний', summary: 'не удалось разобрать ответ модели' }; }\nreturn [{ json: { ok: true, ...parsed } }];"
      },
      "id": "code-2",
      "name": "Разбор ответа",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "resp-1",
      "name": "Ответ",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Лид-захват: каждая классифицированная заявка попадает в очередь менеджера\nconst staticData = $getWorkflowStaticData('global');\nstaticData.leads = staticData.leads || [];\nconst src = $('Валидация').first().json;\nstaticData.leads.push({\n  user: src.user, text: String(src.text || '').slice(0, 200),\n  category: $json.category, priority: $json.priority, summary: $json.summary,\n  ts: new Date().toISOString(),\n});\nif (staticData.leads.length > 200) { staticData.leads.splice(0, staticData.leads.length - 200); }\nreturn [{ json: $json }];"
      },
      "id": "code-lead",
      "name": "Лид-захват",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "demo/leads",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "wh-leads",
      "name": "Webhook leads",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "webhookId": "demo-leads"
    },
    {
      "parameters": {
        "jsCode": "// Очередь заявок для менеджера: последние 20, свежие сверху\nconst staticData = $getWorkflowStaticData('global');\nstaticData.leads = staticData.leads || [];\nreturn [{ json: { ok: true, leads: staticData.leads.slice(-20).reverse() } }];"
      },
      "id": "code-leads",
      "name": "Лиды",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "resp-leads",
      "name": "Ответ leads",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        220
      ]
    }
  ],
